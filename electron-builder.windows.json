{
  "$schema": "https://raw.githubusercontent.com/electron-userland/electron-builder/master/packages/app-builder-lib/scheme.json",
  "appId": "com.vision-studio-x.app",
  "productName": "Vision Studio",
  "copyright": "Copyright © 2024-2026 Vision Studio Team",
  "directories": {
    "output": "release",
    "buildResources": "build"
  },
  "files": [
    "dist/**/*",
    "dist-electron/**/*",
    "!backend/**/*",
    "!resources/**/*",
    "!**/*.pyc",
    "!**/*.pyo",
    "!**/*.pyd"
  ],
  "extraResources": [
    {
      "from": "resources/",
      "to": ".",
      "filter": [
        "**/*"
      ]
    },
    {
      "from": "THIRD-PARTY-LICENSES.md",
      "to": "THIRD-PARTY-LICENSES.md"
    },
    {
      "from": "LICENSE",
      "to": "LICENSE"
    },
    {
      "from": "backend/",
      "to": "backend-source/",
      "filter": [
        "**/*",
        "!venv/**/*",
        "!build/**/*",
        "!dist/**/*",
        "!__pycache__/**/*",
        "!*.pyc",
        "!models/**/*",
        "!data/**/*",
        "!outputs/**/*",
        "!.pytest_cache/**/*"
      ]
    }
  ],
  "win": {
    "target": [
      {
        "target": "dir",
        "arch": [
          "x64"
        ]
      }
    ],
    "icon": "build/icon.ico",
    "signtoolOptions": {
      "publisherName": "Sharif Elsalaymeh"
    },
    "verifyUpdateCodeSignature": true,
    "requestedExecutionLevel": "asInvoker"
  },
  "compression": "store",
  "publish": {
    "provider": "generic",
    "url": "https://updates.vision-studio-x.com/win/",
    "useMultipleRangeRequest": false
  }
}
