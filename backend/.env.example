# Vision Studio backend - environment variables it actually reads.
#
# This file is documentation, not configuration: the backend never loads a
# .env file. Set these in the environment of the process that starts it.
# The desktop app sets the first group itself whenever it spawns the backend
# (electron/services/backendProcess.ts buildBackendEnvironment); set them by
# hand only when running `python main.py` standalone. Every value below is
# the default the backend uses when the variable is unset.

# --- Set by the desktop app -------------------------------------------------
# Required header value for every non-exempt route and the /ws socket.
# Unset: the backend generates a random token for that run (never logged).
# VISION_STUDIO_BACKEND_AUTH_TOKEN=
# Where model weights and Foundry state (.foundry/*.json) live.
# MODELS_DIR=<backend>/models
# Where generated images/videos are written (served under /outputs/).
# OUTPUT_DIR=<backend>/outputs
# SQLite database file (jobs, schema version). Its folder also holds retrieval/.
# DATABASE_PATH=<backend>/data/vision_studio.db
# Optional log file (rotating). Unset: console logging only.
# LOG_FILE=
# Version the backend reports (the shell owns the version number).
# VISION_STUDIO_VERSION=

# --- Server -----------------------------------------------------------------
# Bind address. Loopback by default; set 0.0.0.0 only to deliberately expose
# the backend on the LAN. The port is always 8000.
# VISION_STUDIO_BACKEND_HOST=127.0.0.1
# 1/true/yes: uvicorn auto-reload (development only).
# VISION_STUDIO_BACKEND_RELOAD=
# 1/true/yes/on: turn request rate limiting off (the test suite sets it).
# VISION_STUDIO_DISABLE_RATE_LIMIT=
# Root logger level: DEBUG, INFO, WARNING, ERROR.
# LOG_LEVEL=INFO

# --- Paths --------------------------------------------------------------------
# Extra folders media requests may read from, separated by the OS path
# separator (; on Windows, : elsewhere). The outputs folder and the Foundry
# library roots are always allowed.
# VISION_STUDIO_MEDIA_ROOTS=
# Retrieval index (corpus.json, vectors.npz). Default: <DATABASE_PATH dir>/retrieval
# RETRIEVAL_DATA_DIR=
# Step-preview decoders (taesd family). Default: the installer's
# preview-decoders folder; a path that does not exist disables previews.
# VISION_STUDIO_PREVIEW_DECODERS_DIR=
# TensorRT engine cache (only used when a TensorRT runtime is installed).
# VS_TRT_CACHE_DIR=.cache/tensorrt

# --- Integrations -------------------------------------------------------------
# ComfyUI server. Unreachable: generation runs on the built-in direct path.
# COMFYUI_URL=http://127.0.0.1:8188

# --- Read by bundled libraries, not by Vision Studio code ----------------------
# Hugging Face cache/token for huggingface_hub (the app passes the user's token
# per request; these only matter for a standalone run).
# HF_HOME=
# HF_TOKEN=
# PyTorch: CUDA allocator tuning, GPU selection. macOS sets
# PYTORCH_ENABLE_MPS_FALLBACK=1 itself.
# PYTORCH_CUDA_ALLOC_CONF=
# CUDA_VISIBLE_DEVICES=
